# ============================================================================
# upay AI Shield Enterprise — Secure Environment Configuration Template
# ============================================================================

# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL enterprise production / SQLite development)
DATABASE_URL=sqlite:///upay_ai_shield.db
# DATABASE_URL=postgresql://upay_admin:CHANGE_ME_SECURE_PASSWORD@localhost:5432/upay_ai_shield

# Authentication & Cryptographic Tokens (Do NOT use default secret in production!)
UPAY_AUTH_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Models & Machine Learning Settings
MODEL_VERSION=v2.1.0-scientific-xgboost
AUTONOMOUS_BLOCKING_ALLOWED=False
HUMAN_IN_THE_LOOP_REQUIRED=True

# Regulatory & Governance Compliance (BFIU Master Circular 24)
JURISDICTION=Bangladesh
REGULATORY_BODY=Bangladesh Financial Intelligence Unit (BFIU)
PRIMARY_CURRENCY=BDT
HIGH_VALUE_THRESHOLD_BDT=25000.0
SIM_SWAP_WINDOW_HOURS=24
NIGHT_HOURS_START=0
NIGHT_HOURS_END=5
