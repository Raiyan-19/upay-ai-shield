# ============================================================================
# upay AI Shield — Enterprise Environment Configuration
# ============================================================================

# Environment: development | staging | production
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite default / PostgreSQL compatible)
DATABASE_URL=sqlite:///upay_ai_shield.db
# DATABASE_URL=postgresql://upay_user:secure_password@localhost:5432/upay_ai_shield

# Authentication & Cryptographic Tokens
UPAY_AUTH_SECRET=upay-ai-shield-secret-production-key-2026-bangladesh
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Models & Machine Learning Settings
MODEL_VERSION=v1.2.4-xgboost-prod
AUTONOMOUS_BLOCKING_ALLOWED=False
HUMAN_IN_THE_LOOP_REQUIRED=True

# Regulatory & Governance Compliance
JURISDICTION=Bangladesh
REGULATORY_BODY=Bangladesh Financial Intelligence Unit (BFIU)
PRIMARY_CURRENCY=BDT
HIGH_VALUE_THRESHOLD_BDT=25000.0
SIM_SWAP_WINDOW_HOURS=24
NIGHT_HOURS_START=0
NIGHT_HOURS_END=5
